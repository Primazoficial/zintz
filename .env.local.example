NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave da API Anthropic (console.anthropic.com) — necessária para classificação e extração de dados
ANTHROPIC_API_KEY=

# Opcional, só em dev: preencha os dois para pular a tela de /entrar ao rodar
# `next dev` (inclusive via LAN no celular). Nunca tem efeito em produção.
# Precisa ser um usuário real já cadastrado no seu projeto Supabase.
DEV_AUTO_LOGIN_EMAIL=
DEV_AUTO_LOGIN_SENHA=
